# CMake and generated build trees
/build/
/build-*/
/cmake-build-*/
/candidate/build/
/candidate/build-*/
/evaluator/build/
/evaluator/build-*/
/evaluator/conformance/build-under-test/
**/CMakeFiles/
**/CMakeCache.txt
**/CTestTestfile.cmake
**/Testing/
**/cmake_install.cmake
**/Makefile

# Compiled artifacts and profiling/debug output
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# Python cache files
__pycache__/
*.py[cod]

# Raw session material and local credentials must never enter the public archive.
sessions/*/session/
sessions/*/*.jsonl
.env
.env.*
!.env.example

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
*~
